+void MapblockMeshGenerator::generateTerrainLod(u8 stride)
+{
+	ZoneScoped;
+	assert(stride >= 2 && stride <= MAP_BLOCKSIZE);
+	assert(data->m_side_length % stride == 0);
+
+	struct SurfaceSample {
+		bool valid = false;
+		s16 height = 0;
+		MapNode node;
+		v3s16 pos;
+	};
+
+	const auto is_full_opaque_block = [&] (MapNode node) {
+		if (node.getContent() == CONTENT_AIR || node.getContent() == CONTENT_IGNORE)
+			return false;
+		const ContentFeatures &f = nodedef->get(node);
+		return f.drawtype == NDT_NORMAL && f.alpha == AlphaMode::ALPHAMODE_OPAQUE;
+	};
+
+	const auto is_lod_material = [&] (MapNode node) {
+		const ContentFeatures &f = nodedef->get(node);
+		if (f.drawtype != NDT_NORMAL || f.alpha != AlphaMode::ALPHAMODE_OPAQUE ||
+				f.waving || std::fabs(f.visual_scale - 1.0f) > 1e-3f || !f.visuals)
+			return false;
+
+		for (const TileSpec &tile : f.visuals->tiles) {
+			for (const TileLayer &layer : tile.layers) {
+				if (layer.empty())
+					continue;
+				if ((layer.material_type != TILE_MATERIAL_OPAQUE &&
+						layer.material_type != TILE_MATERIAL_BASIC) ||
+						(layer.material_flags & MATERIAL_FLAG_ANIMATION))
+					return false;
+			}
+		}
+		return true;
+	};
+
+	const s16 cells = data->m_side_length / stride;
+	const s16 grid_size = cells + 2; // one LOD cell of neighbor padding
+	std::vector<SurfaceSample> heights(grid_size * grid_size);
+	const auto height_at = [&] (s16 x, s16 z) -> SurfaceSample & {
+		return heights[(z + 1) * grid_size + (x + 1)];
+	};
+
+	// The median of opaque columns suppresses isolated peaks while preserving
+	// the broad terrain shape.
+	for (s16 cell_z = -1; cell_z <= cells; cell_z++)
+	for (s16 cell_x = -1; cell_x <= cells; cell_x++) {
+		std::vector<SurfaceSample> candidates;
+		candidates.reserve(stride * stride);
+		for (s16 z = cell_z * stride; z < (cell_z + 1) * stride; z++)
+		for (s16 x = cell_x * stride; x < (cell_x + 1) * stride; x++) {
+			for (s16 y = data->m_side_length - 1; y >= 0; y--) {
+				v3s16 pos = blockpos_nodes + v3s16(x, y, z);
+				MapNode node = data->m_vmanip.getNodeNoExNoEmerge(pos);
+				if (!is_full_opaque_block(node))
+					continue;
+
+				MapNode above = data->m_vmanip.getNodeNoExNoEmerge(pos + v3s16(0, 1, 0));
+				if (is_lod_material(node) && !is_full_opaque_block(above))
+					candidates.push_back({true, y, node, v3s16(x, y, z)});
+				break;
+			}
+		}
+
+		if (candidates.empty())
+			continue;
+		std::sort(candidates.begin(), candidates.end(), [] (const SurfaceSample &a,
+				const SurfaceSample &b) { return a.height < b.height; });
+		height_at(cell_x, cell_z) = candidates[candidates.size() / 2];
+	}
+
+	constexpr u8 all_faces = 0b0011'1111;
+	const auto draw_lod_box = [&] (const aabb3f &box, TileSpec *tiles, u8 face) {
+		f32 texture_coords[24];
+		generateCuboidTextureCoords(box, texture_coords);
+		drawAutoLightedCuboid(box, tiles, 6, texture_coords,
+			all_faces ^ (1u << face));
+	};
+
+	for (s16 cell_z = 0; cell_z < cells; cell_z++)
+	for (s16 cell_x = 0; cell_x < cells; cell_x++) {
+		const SurfaceSample &sample = height_at(cell_x, cell_z);
+		if (!sample.valid)
+			continue;
+
+		cur_node.p = sample.pos;
+		cur_node.origin = intToFloat(cur_node.p, BS);
+		cur_node.n = sample.node;
+		cur_node.f = &nodedef->get(cur_node.n);
+		cur_node.lcolor = encode_light(getInteriorLight(cur_node.n, 0, nodedef),
+			cur_node.f->light_source);
+
+		TileSpec tiles[6];
+		for (int face = 0; face < 6; face++)
+			getTile(tile_dirs[face], &tiles[face]);
+
+		const f32 x_min = (cell_x * stride - sample.pos.X - 0.5f) * BS;
+		const f32 x_max = ((cell_x + 1) * stride - sample.pos.X - 0.5f) * BS;
+		const f32 z_min = (cell_z * stride - sample.pos.Z - 0.5f) * BS;
+		const f32 z_max = ((cell_z + 1) * stride - sample.pos.Z - 0.5f) * BS;
+		const f32 top = 0.5f * BS;
+		draw_lod_box(aabb3f(v3f(x_min, -top, z_min), v3f(x_max, top, z_max)),
+			tiles, 0);
+
+		const auto draw_side = [&] (s16 neighbor_x, s16 neighbor_z, u8 face,
+				f32 edge, bool along_x) {
+			const SurfaceSample &neighbor = height_at(neighbor_x, neighbor_z);
+			if (!neighbor.valid || neighbor.height >= sample.height)
+				return;
+			const f32 bottom = (neighbor.height - sample.height + 0.5f) * BS;
+			const f32 epsilon = BS / 1024.0f;
+			if (along_x) {
+				const f32 sx = (edge - sample.pos.X) * BS;
+				const aabb3f side = (face == 3) ?
+					aabb3f(v3f(sx, bottom, z_min), v3f(sx + epsilon, top, z_max)) :
+					aabb3f(v3f(sx - epsilon, bottom, z_min), v3f(sx, top, z_max));
+				draw_lod_box(side, tiles, face);
+			} else {
+				const f32 sz = (edge - sample.pos.Z) * BS;
+				const aabb3f side = (face == 5) ?
+					aabb3f(v3f(x_min, bottom, sz), v3f(x_max, top, sz + epsilon)) :
+					aabb3f(v3f(x_min, bottom, sz - epsilon), v3f(x_max, top, sz));
+				draw_lod_box(side, tiles, face);
+			}
+		};
+
+		draw_side(cell_x - 1, cell_z, 3, cell_x * stride - 0.5f, true);
+		draw_side(cell_x + 1, cell_z, 2, (cell_x + 1) * stride - 0.5f, true);
+		draw_side(cell_x, cell_z - 1, 5, cell_z * stride - 0.5f, false);
+		draw_side(cell_x, cell_z + 1, 4, (cell_z + 1) * stride - 0.5f, false);
+	}
+}
