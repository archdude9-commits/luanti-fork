+void TestMapblockMeshGenerator::testTerrainLod()
+{
+	MockGameDef gamedef;
+	content_t stone = gamedef.addSimpleNode("stone", 42);
+	gamedef.finalize();
+
+	MeshMakeData data{gamedef.ndef(), MAP_BLOCKSIZE, MeshGrid{1}};
+	data.m_generate_minimap = false;
+	data.m_smooth_lighting = false;
+	data.fillBlockDataBegin({0, 0, 0});
+	for (s16 z = 0; z < MAP_BLOCKSIZE; z++)
+	for (s16 x = 0; x < MAP_BLOCKSIZE; x++) {
+		s16 height = x < MAP_BLOCKSIZE / 2 ? 0 : 2;
+		data.m_vmanip.setNode({x, height, z}, {stone, 0, 0});
+	}
+
+	MeshCollector col{{}};
+	MapblockMeshGenerator mg{&data, &col};
+	mg.generateTerrainLod(4);
+
+	u32 vertex_count = 0;
+	u32 index_count = 0;
+	for (const PreMeshBuffer &buffer : col.prebuffers[0]) {
+		vertex_count += buffer.vertices.size();
+		index_count += buffer.indices.size();
+	}
+	UASSERTEQ(u32, vertex_count, 20 * 4);
+	UASSERTEQ(u32, index_count, 20 * 6);
+	UASSERTEQ(std::size_t, col.prebuffers[1].size(), 0);
+}
